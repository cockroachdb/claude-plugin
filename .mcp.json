{
  "mcpServers": {
    "cockroachdb-toolbox": {
      "command": "toolbox",
      "args": ["--config", "${CLAUDE_PLUGIN_ROOT}/tools.yaml", "--stdio"],
      "env": {
        "COCKROACHDB_HOST": "${COCKROACHDB_HOST:-localhost}",
        "COCKROACHDB_PORT": "${COCKROACHDB_PORT:-26257}",
        "COCKROACHDB_USER": "${COCKROACHDB_USER:-root}",
        "COCKROACHDB_PASSWORD": "${COCKROACHDB_PASSWORD:-}",
        "COCKROACHDB_DATABASE": "${COCKROACHDB_DATABASE:-defaultdb}",
        "COCKROACHDB_SSLMODE": "${COCKROACHDB_SSLMODE:-require}"
      }
    },
    "cockroachdb-cloud": {
      "type": "http",
      "url": "https://cockroachlabs.cloud/mcp",
      "headers": {
        "mcp-cluster-id": "${COCKROACHDB_CLUSTER_ID:-}"
      }
    }
  }
}
